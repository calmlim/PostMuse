{
  "name": "postmuse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --watch --mode development",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "i18n:inline": "node scripts/generate-inline-catalog.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && node scripts/build.mjs",
    "build:store": "npm run typecheck && node scripts/build.mjs --profile store",
    "audit:release": "node scripts/release-audit.mjs",
    "audit:store": "node scripts/release-audit.mjs --profile store",
    "package:store": "npm run build:store && npm run audit:store && node scripts/package-extension.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run audit:release"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "fake-indexeddb": "^6.2.5",
    "fflate": "^0.8.2",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
